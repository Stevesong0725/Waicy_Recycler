# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)
# Vercel 배포 시에는 Project Settings → Environment Variables 에 같은 이름으로 넣으세요.

# 필수
OPENAI_API_KEY=

# 선택: 사용할 모델 (기본 gpt-5.4-mini)
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=low
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# 선택(배포 시 권장): 설정하면 앱 설정에 같은 코드를 입력한 기기만 API를 쓸 수 있어요
# APP_ACCESS_CODE=
